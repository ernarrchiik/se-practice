{
  "name": "check_room",
  "description": "Check whether a room is available for a proposed time interval. Provide all times as whole minutes since midnight, from 0 to 1440 inclusive, along with the room's blocked status and existing bookings. This tool only checks availability and does not save or create a booking.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "start": { "type": "integer", "minimum": 0, "maximum": 1440 },
      "end": { "type": "integer", "minimum": 0, "maximum": 1440 },
      "now": { "type": "integer", "minimum": 0, "maximum": 1440 },
      "blocked": { "type": "boolean" },
      "bookings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "start": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "end": { "type": "integer", "minimum": 0, "maximum": 1440 }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        }
      }
    },
    "required": ["start", "end", "now", "blocked", "bookings"],
    "additionalProperties": false
  }
}